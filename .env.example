# Copy to .env and add a key from https://console.groq.com/keys.
# Start with: .venv/bin/python -m uvicorn src.web.api:app --env-file .env
# Keep .env on the server; never put this key in browser JavaScript.
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Public Docker Compose deployment only: hostname without https:// or a path.
# For a free hostname, replace the IP in laptop.203.0.113.10.sslip.io.
APP_DOMAIN=

# For the original NVIDIA model, set LLM_PROVIDER=local instead.
